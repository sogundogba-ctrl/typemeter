---
const { title = 'TypeMeter', description = 'Free typing speed test, practice and games.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f172a" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/images/brand/favicon.svg" />
    <script is:inline>
      const savedTheme = localStorage.getItem('typemeter-theme');
      const t = savedTheme || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.dataset.theme = t;
    </script>
    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
