---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Type Snap Global Leaderboard – Top Typing Scores | TypeMeter" description="View the top verified Type Snap scores submitted to TypeMeter.">
  <article class="page-shell">
    <p class="eyebrow">Leaderboard</p>
    <h1>Type Snap Global Leaderboard</h1>
    <p>Top verified Type Snap scores submitted to TypeMeter.</p>
    <div class="leaderboard-shell">
      <table>
        <thead>
          <tr><th>#</th><th>Country</th><th>Score</th><th>Avg. time</th></tr>
        </thead>
        <tbody>
          <tr><td>1</td><td><img src="/images/flags/international.svg" alt="International" width="24" height="16" /></td><td>9240</td><td>2100ms</td></tr>
        </tbody>
      </table>
    </div>
  </article>
</BaseLayout>
