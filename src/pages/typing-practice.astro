---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Typing Practice – Free Online Typing Practice | TypeMeter" description="Practice typing with targeted exercises, timed sessions and feedback on accuracy and weak keys.">
  <article class="page-shell">
    <p class="eyebrow">Practice</p>
    <h1>Typing Practice</h1>
    <p>Build consistent rhythm with short exercises that focus on speed, accuracy and recovery.</p>
    <div class="practice-grid">
      <div class="panel">
        <h2>Session</h2>
        <p class="stat">Live WPM: <strong>0.0</strong></p>
        <p class="stat">Accuracy: <strong>100%</strong></p>
        <p class="stat">Errors: <strong>0</strong></p>
        <button type="button">Start</button>
      </div>
      <div class="panel">
        <h2>Targeted drills</h2>
        <ul>
          <li>Common words</li>
          <li>Long words</li>
          <li>Numbers</li>
          <li>Punctuation</li>
        </ul>
      </div>
    </div>
  </article>
</BaseLayout>
