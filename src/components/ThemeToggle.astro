---
const { label = 'Toggle theme' } = Astro.props;
---
<button type="button" class="theme-button" aria-label={label} aria-pressed="false">
  <span class="theme-icon-wrap"><Icon name="sun" size={16} /></span>
  <span>Theme</span>
</button>
<script>
  const button = document.querySelector('.theme-button');
  const root = document.documentElement;
  const applyTheme = (theme) => {
    root.dataset.theme = theme;
    localStorage.setItem('typemeter-theme', theme);
    const icon = button?.querySelector('.theme-icon-wrap');
    if (icon) {
      icon.innerHTML = theme === 'dark' ? '<svg ...></svg>' : '<svg ...></svg>';
    }
  };
  const current = localStorage.getItem('typemeter-theme') || 'light';
  applyTheme(current);
  button?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    applyTheme(next);
  });
</script>
