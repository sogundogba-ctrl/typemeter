---
<button class="theme-button" type="button" aria-label="Toggle theme">
  Light / Dark
</button>
<script>
  const toggle = document.querySelector('.theme-button');
  const root = document.documentElement;
  const applyTheme = (theme) => {
    root.dataset.theme = theme;
    localStorage.setItem('typemeter-theme', theme);
  };
  const currentTheme = localStorage.getItem('typemeter-theme') || 'light';
  applyTheme(currentTheme);
  toggle?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    applyTheme(next);
  });
</script>
